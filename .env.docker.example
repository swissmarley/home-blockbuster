# Settings for docker-compose.yml. The installer writes this file for you; to set it up by hand,
# copy it to .env. Values containing special characters should be wrapped in 'single quotes'.

# Image tag from ghcr.io/swissmarley/home-blockbuster (latest, or a version such as 1.0.0)
HB_VERSION=latest
TZ=UTC

# Name(s) or IP(s) you open the app with, comma separated. Clients must use one of these exactly.
#   LAN:    nas.local, 192.168.1.20      Internet: media.example.com
HB_DOMAIN=localhost

# internal       -> certificate from Caddy's local CA (LAN names, IPs). Install ./home-blockbuster-root-ca.crt
#                   on each device once so it trusts the server (the installer exports it).
# you@mail.com   -> free Let's Encrypt certificate for a public HB_DOMAIN (ports 80 and 443 must reach this machine)
# /certs/fullchain.pem /certs/privkey.pem -> your own certificate files, placed in ./certs
HB_TLS=internal

# Public ports (change both only if 80/443 are taken; Let's Encrypt needs the standard ones).
# With a non-standard HTTPS port, open the app with the port (https://nas.local:8443): the
# http -> https redirect does not carry it over.
HB_HTTP_PORT=80
HB_HTTPS_PORT=443

# Folders on this machine, mounted read-only as /media/movies and /media/tv inside the container
HB_MOVIES_DIR=./media/movies
HB_TV_DIR=./media/tv

# Require a password (strongly recommended for anything reachable from the internet)
HB_PASSWORD=

# Optional metadata keys (can also be entered in Settings → Metadata)
TMDB_API_KEY=
OMDB_API_KEY=
