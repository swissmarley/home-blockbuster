# Settings for docker-compose.deploy.yml (the installer writes this file for you). To set it up by
# hand, copy it to .env and run: docker compose -f docker-compose.deploy.yml up -d
# Values containing special characters should be wrapped in 'single quotes'.

# Image tag from ghcr.io/swissmarley/home-blockbuster (latest, or a version such as 1.1.0)
HB_VERSION=latest
TZ=UTC

# How devices connect. Exactly one of: tailscale | http | caddy
COMPOSE_PROFILES=tailscale

# Companion settings for each mode (the installer fills these in):
#   tailscale:  HB_BIND=127.0.0.1  HB_TRUST_PROXY=1  HB_ALLOWED_HOSTS=.ts.net
#   http:       HB_BIND=0.0.0.0    HB_TRUST_PROXY=    HB_ALLOWED_HOSTS=
#   caddy:      HB_BIND=127.0.0.1  HB_TRUST_PROXY=1  HB_ALLOWED_HOSTS=<your HB_DOMAIN>
HB_BIND=127.0.0.1
HB_PORT=8585
HB_TRUST_PROXY=1
HB_ALLOWED_HOSTS=.ts.net

# --- tailscale mode ---
# Name of this device in your tailnet: the app is then https://<name>.<your-tailnet>.ts.net
# One-time: in the Tailscale admin console (DNS page) turn on MagicDNS and HTTPS Certificates.
HB_TS_HOSTNAME=home-blockbuster
# Optional auth key (https://login.tailscale.com/admin/settings/keys); without it, open the login link printed by the installer
HB_TS_AUTHKEY=

# --- caddy mode ---
# Name(s) or IP(s) you open the app with, comma separated. Clients must use one of these exactly.
HB_DOMAIN=localhost
# internal       -> certificate from Caddy's local CA (devices must trust ./home-blockbuster-root-ca.crt)
# you@mail.com   -> free Let's Encrypt certificate for a public HB_DOMAIN (ports 80 and 443 must reach this machine)
# /certs/fullchain.pem /certs/privkey.pem -> your own certificate files, placed in ./certs
HB_TLS=internal
# Change both only if 80/443 are taken. With a non-standard HTTPS port, open the app with the port
# (https://nas.local:8443): the http -> https redirect does not carry it over.
HB_HTTP_PORT=80
HB_HTTPS_PORT=443

# Folders on this machine, mounted read-only as /media/movies and /media/tv inside the container
HB_MOVIES_DIR=./media/movies
HB_TV_DIR=./media/tv

# Require a password (strongly recommended for anything reachable beyond your own devices)
HB_PASSWORD=

# Optional metadata keys (can also be entered in Settings → Metadata)
TMDB_API_KEY=
OMDB_API_KEY=
