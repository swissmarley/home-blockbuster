<?xml version="1.0" encoding="utf-8"?>
<!-- Home Blockbuster servers are self-hosted: usually plain HTTP on a home network, or HTTPS with
     Caddy's private local CA, which the user installs as a user certificate on the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
