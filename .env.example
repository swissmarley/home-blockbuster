# Copy to .env (or set these in your shell / service manager). All are optional.

# Web server
PORT=8585
HOST=0.0.0.0

# Where the database, artwork cache and thumbnails are stored
DATA_DIR=./data

# Require a password to use the app (or set one in Settings → Security)
HB_PASSWORD=

# Behind a reverse proxy: trust X-Forwarded-* headers (1 = one proxy hop)
TRUST_PROXY=

# Without a password, extra host names to answer to besides IPs, localhost and LAN names
ALLOWED_HOSTS=

# Follow symlinks that point outside every library folder (1 to enable)
ALLOW_EXTERNAL_SYMLINKS=

# Metadata API keys (can also be entered in Settings → Metadata)
TMDB_API_KEY=
OMDB_API_KEY=

# ffmpeg / ffprobe location if they are not on the PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Extra folders shown as shortcuts in the folder browser (comma or semicolon separated)
MEDIA_ROOTS=

# debug | info | warn | error
LOG_LEVEL=info
