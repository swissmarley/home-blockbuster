# Copy to .env (or set these in your shell / service manager). All are optional.

# Web server
PORT=8585
HOST=0.0.0.0

# Where the database, artwork cache and thumbnails are stored
DATA_DIR=./data

# Require a password to use the app
HB_PASSWORD=

# Metadata API keys (can also be entered in Settings → Metadata)
TMDB_API_KEY=
OMDB_API_KEY=

# ffmpeg / ffprobe location if they are not on the PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Extra folders shown as shortcuts in the folder browser (comma or semicolon separated)
MEDIA_ROOTS=

# debug | info | warn | error
LOG_LEVEL=info
